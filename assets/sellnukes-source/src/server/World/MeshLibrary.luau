--!strict
--[[
	MeshLibrary — spawns SellNukes' Blender-authored world models as stud-textured MeshParts.

	Contract (docs/superpowers/plans/2026-10-30-sellnukes-build.md, "Meshes"):
		MeshLibrary.preload(keys)                          -- fetch mesh templates ahead of time
		MeshLibrary.prefetch(keys, priority?)              -- queue them without yielding
		MeshLibrary.spawn(modelKey, parent, pivot, opts?)  -> Model
	A model is built from Blender MeshParts when EVERY piece has an uploaded MeshId that loads;
	otherwise from the primitive fallback (one box Part per piece, same size/offset/colour/stud
	material), so a level is always complete and correctly sized even before uploads.

	Data: src/shared/Config/MeshAssets.luau (generated by tools/blender/sync_meshes.py).
	Look: WorldMaterials (stud MaterialVariants) is applied to every piece by its manifest material.

	Performance:
		* ONE template MeshPart per MeshId (AssetService:CreateMeshPartAsync), cached for the server's
		  lifetime and cloned per spawn — no repeated asset requests, no EditableMesh.
		* Template fetches are de-duplicated (concurrent callers wait on the same request), run at
		  most MAX_CONCURRENT at a time, retry with backoff, and failed ids cool down for
		  RETRY_COOLDOWN seconds instead of hammering the asset service.
		* Visual pieces are Anchored, CanCollide/CanQuery/CanTouch = false, Massless, no fluid
		  forces: zero physics/query cost. Collision is separate invisible primitives (B5).
		* Models are parented once, after every piece is built (one replication burst).
		* Mesh pieces are placed with MeshPlacement.pieceCFrame (undoes the FBX import's 180° yaw)
		  and carry attribute MeshYaw: SurfaceGuis on a piece must use MeshPlacement.face(part, ...).
		  Big Neon pieces follow the glow budget (MeshPlacement.resolveGlow).
		* Each piece carries `BuildOrder` (bottom-to-top index, for the client build-in) and, when its
		  name is animatable per WorldFxConfig (Rotor, Belt, Glow, ...), the `WorldFx` tag.
		* No per-frame work, no connections.

	Player-first load order (owner R16 follow-up: WorldReady <= 7 s, own full plot <= 8 s):
		* WorldReady gates only the FIRST VIEW: hub models near the spawn (NEAR_HUB_RADIUS), plot
		  frame, BuyPad, Area 1, spawns of first-view keys and builder holds (holdWorldReady).
		* Far hub decoration loads at Background after it — once HubBuilder builds near-first and
		  holds WorldReady("hub") for that pass; a single-pass HubBuilder keeps the old gate.
		* Boot phase (before WorldReady): spawns of keys nobody marked first view (effect templates,
		  event decor, rival turrets) are deferred — Deferred priority (after the own plots, before
		  the warm-up tiers), never holding WorldReady.
		  SpawnOptions.deferred / .priority let scenery opt out explicitly at any time.
		* First-view requests retry with a short backoff; stats() lists retries + slowest requests.

	Yielding: spawn() yields only while templates for that key are still loading. Call preload()
	for an area's keys before a build-in so the purchase appears instantly.

	Security: server-only module; model keys come from server config (TycoonConfig pad build
	lists), never from clients. Unknown keys error loudly (programming bug, caught in tests).

	Example:
		local MeshLibrary = require(ServerScriptService.Server.World.MeshLibrary)
		MeshLibrary.preload({ "BuyPad", "Workbench" })
		local pad = MeshLibrary.spawn("BuyPad", plotFolder, origin * CFrame.new(0, 0, -20), {
			tint = Color3.fromRGB(232, 64, 56), -- red "decoration" pad top
		})
]]

local AssetService = game:GetService("AssetService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local MeshAssets = require(ReplicatedStorage.Shared.Config.MeshAssets)
local WorldFxConfig = require(ReplicatedStorage.Shared.Config.WorldFxConfig)
local MeshPlacement = require(ReplicatedStorage.Shared.World.MeshPlacement)
local PreloadList = require(ReplicatedStorage.Shared.World.PreloadList)
local WorldMaterials = require(script.Parent.WorldMaterials)

export type SpawnOptions = {
	-- Colour for every piece marked `tinted` in the manifest (pad tops, nuke tier bodies).
	tint: Color3?,
	-- Per-piece colour overrides by piece name; wins over `tint`. Unknown names are ignored.
	colors: { [string]: Color3 }?,
	-- Model name (default: the model key).
	name: string?,
	-- Force the primitive fallback even when meshes are uploaded (debug / A-B comparisons).
	fallback: boolean?,
	-- StreamingEnabled behaviour; default Atomic so a model never half-streams in.
	streamingMode: Enum.ModelStreamingMode?,
	-- Shadows for every piece (default true). Turn off for flat floor tiles to save shadow cost.
	castShadow: boolean?,
	-- Template request priority (MeshLibrary.Priority). Default: Now, or Background for `deferred`.
	priority: number?,
	-- Scenery nobody waits on (rival islands, far decoration, effect templates): never holds back
	-- Workspace.WorldReady and loads at Background priority unless `priority` says otherwise.
	deferred: boolean?,
}

local MeshLibrary = {}

--[[
	Request priorities (lower = sooner). A request waiting for a slot is promoted when a more urgent
	caller asks for the same mesh, so a player never waits behind the background warm-up.
		Now         a spawn someone is waiting on (purchase, plot build)
		Hub         boot warm-up tier 1: hub, plot frame, BuyPad, Area 1 (what every new player sees)
		Plot        a joining player's plot restore (their bought builds, area 1 first)
		Deferred    boot-phase spawns of non-first-view keys (effect templates, event decor,
		            rival turrets): right after the players' own plots, before the warm-up tiers
		Background  boot warm-up tiers 2-3 (areas 2-10), far hub decoration, `deferred` spawns
		Idle        boot warm-up tier 4 (pets, eggs, crates, attack, event, ...)
]]
MeshLibrary.Priority = table.freeze({ Now = 0, Hub = 1, Plot = 2, Deferred = 2.5, Background = 3, Idle = 4 })

-- Legacy switch (benchmarks only): set attribute LegacyLoading = true on this ModuleScript in edit
-- mode before a playtest to get the pre-R16 behaviour (6 in flight, FIFO, no boot warm-up).
local LEGACY = script:GetAttribute("LegacyLoading") == true
-- Max simultaneous CreateMeshPartAsync requests: bounded so a warm-up cannot flood the asset
-- service, high enough that hub + Area 1 load in a few round trips (owner R16). Loading is
-- latency-bound (W1 benchmark 2026-10-30: p50 0.20 s / p90 0.27 s per template at 16 in flight,
-- ~80 templates/s, so a fully built plot of ~1000 meshes was ready at 13.7 s); 32 slots roughly
-- double throughput while retries + cooldown still protect the asset service. Re-measure with
-- tools/qa/load_benchmark.py after changing this.
local MAX_CONCURRENT = if LEGACY then 6 else 32
-- Attempts per template request before cooling down.
local MAX_ATTEMPTS = 3
-- First retry delay in seconds; doubles each attempt (0.5, 1.0, ...).
local RETRY_BASE_DELAY = 0.5
-- First retry delay for first-view requests (Now / Hub): a failed hub or own-plot template must
-- not hold the loading screen for seconds of backoff (0.15, 0.3, ...).
local URGENT_RETRY_BASE_DELAY = 0.15
-- Hub models within this many studs of HubLayout.spawn are "first view": they gate WorldReady.
-- Hub decoration farther out loads at Background priority after it (owner R16 follow-up) once
-- HubBuilder builds near-first (it calls holdWorldReady(HUB_HOLD) for its near pass).
local NEAR_HUB_RADIUS = 200
-- The WorldReady hold reason HubBuilder uses for its near-first pass (see holdWorldReady).
local HUB_HOLD = "hub"
-- Slowest requests kept for stats() (benchmark diagnostics: which templates hold the tail).
local SLOWEST_KEPT = 8
-- Seconds a failed MeshId is skipped (spawn uses the fallback meanwhile).
local RETRY_COOLDOWN = 60
-- Latency samples kept for stats() (bounded ring).
local MAX_SAMPLES = 4096

local TEMPLATE_OPTIONS = {
	-- Visual pieces never collide, so the cheapest collision geometry is right.
	CollisionFidelity = Enum.CollisionFidelity.Box,
	-- Automatic = engine LOD by distance (big win with hundreds of meshes on screen).
	RenderFidelity = Enum.RenderFidelity.Automatic,
}

type Waiter = { thread: thread, priority: number, seq: number, id: number }

local templates: { [number]: MeshPart } = {}
local failedUntil: { [number]: number } = {}
-- Threads waiting for an in-flight / queued request of the same id.
local waiting: { [number]: { thread } } = {}
-- Queued (not yet started) requests by id, so a more urgent caller can promote them.
local queuedById: { [number]: Waiter } = {}
-- Concurrency limiter: active request count + queue of requests waiting for a slot.
local inFlight = 0
local slotQueue: { Waiter } = {}
local sequence = 0
-- Spawns currently blocked on template loads (WorldReady waits for these to drain).
local pendingSpawns = 0
-- True once Workspace.WorldReady is published (the boot phase is over).
local worldReadyDone = false
-- Keys the first view needs: boot tier 1 (near hub + plot frame + BuyPad + Area 1) plus every key
-- a caller prefetches / preloads at Plot priority or more urgent before WorldReady (a joining
-- player's own plot, the hub build). During the boot phase a spawn of any OTHER key (effect
-- templates, event decoration, rival turrets) is deferred: it neither jumps the queue at Now nor
-- holds back WorldReady.
local firstViewKeys: { [string]: boolean } = {}
-- Active WorldReady holds per reason (MeshLibrary.holdWorldReady) and whether HubBuilder held it.
local holds: { [string]: number } = {}
local hubHoldSeen = false
-- Diagnostics for stats(): retried attempts, deferred boot spawns, the slowest requests.
local retries = 0
local deferredSpawns = 0
type SlowRequest = { id: number, seconds: number, attempts: number, priority: number }
local slowest: { SlowRequest } = {}
-- Timing: module load clock (~server boot), per-request latency ring, milestones.
local bootClock = os.clock()
local samples: { number } = {}
local sampleIndex = 0
local milestones: { [string]: number } = {}
-- Cached model-space bounds per key (computed once from MeshAssets).
local boundsCache: { [string]: { cframe: CFrame, size: Vector3 } } = {}
-- "modelKey/piece" -> animated? (WorldFxConfig.groupFor, cached: names repeat across spawns).
local fxNameCache: { [string]: boolean } = {}

-- True when the client WorldFxController animates this piece (its own row or a model assembly).
local function isFxPiece(modelKey: string, name: string): boolean
	local cacheKey = `{modelKey}/{name}`
	local cached = fxNameCache[cacheKey]
	if cached == nil then
		cached = WorldFxConfig.groupFor(modelKey, name) ~= nil
		fxNameCache[cacheKey] = cached
	end
	return cached
end

-- Blocks until one of MAX_CONCURRENT slots is free; the most urgent waiter goes first.
local function acquireSlot(id: number, priority: number)
	if inFlight < MAX_CONCURRENT and #slotQueue == 0 then
		inFlight += 1
		return
	end
	sequence += 1
	local waiter: Waiter = {
		thread = coroutine.running(),
		priority = if LEGACY then 0 else priority,
		seq = sequence,
		id = id,
	}
	table.insert(slotQueue, waiter)
	queuedById[id] = waiter
	coroutine.yield()
	-- Resumed by releaseSlot(), which hands its slot over without changing inFlight.
end

-- Frees a slot, handing it straight to the most urgent (then oldest) queued request.
local function releaseSlot()
	local best, bestIndex = nil :: Waiter?, 0
	for index, waiter in slotQueue do
		if
			best == nil
			or waiter.priority < best.priority
			or (waiter.priority == best.priority and waiter.seq < best.seq)
		then
			best, bestIndex = waiter, index
		end
	end
	if best ~= nil then
		table.remove(slotQueue, bestIndex)
		queuedById[best.id] = nil
		task.spawn(best.thread)
	else
		inFlight -= 1
	end
end

-- One-time property setup on a fresh template (clones inherit it).
local function prepareTemplate(part: MeshPart)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.EnableFluidForces = false
	part.CastShadow = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

-- Records one request latency (seconds, including retries) in the bounded ring.
local function sample(seconds: number)
	sampleIndex = sampleIndex % MAX_SAMPLES + 1
	samples[sampleIndex] = seconds
end

-- Keeps the SLOWEST_KEPT slowest requests (sorted, slowest first) for stats().
local function noteSlow(id: number, seconds: number, attempts: number, priority: number)
	if #slowest >= SLOWEST_KEPT and seconds <= slowest[#slowest].seconds then
		return
	end
	table.insert(slowest, { id = id, seconds = seconds, attempts = attempts, priority = priority })
	table.sort(slowest, function(a: SlowRequest, b: SlowRequest): boolean
		return a.seconds > b.seconds
	end)
	if #slowest > SLOWEST_KEPT then
		table.remove(slowest)
	end
end

--[[
	Returns the cached template for a MeshId, fetching it (dedupe, priority slot, retries) if
	needed. Returns nil while the id is cooling down after a failure.
]]
local function fetchTemplate(id: number, priority: number): MeshPart?
	local cached = templates[id]
	if cached ~= nil then
		return cached
	end
	if (failedUntil[id] or 0) > os.clock() then
		return nil
	end
	local pending = waiting[id]
	if pending ~= nil then
		-- Already requested: promote it if it is still queued behind less urgent work, then wait.
		local queued = queuedById[id]
		if queued ~= nil and priority < queued.priority and not LEGACY then
			queued.priority = priority
		end
		table.insert(pending, coroutine.running())
		coroutine.yield()
		return templates[id]
	end
	waiting[id] = {}
	acquireSlot(id, priority)
	local started = os.clock()
	local result: MeshPart? = nil
	local lastError: string = "unknown error"
	local attempts = 0
	-- First-view requests retry fast (a backoff here is a loading-screen stall).
	local retryBase = if priority <= MeshLibrary.Priority.Hub then URGENT_RETRY_BASE_DELAY else RETRY_BASE_DELAY
	for attempt = 1, MAX_ATTEMPTS do
		attempts = attempt
		local ok, value = pcall(function(): MeshPart
			return AssetService:CreateMeshPartAsync(Content.fromAssetId(id), TEMPLATE_OPTIONS)
		end)
		if ok then
			result = value
			break
		end
		lastError = tostring(value)
		if attempt < MAX_ATTEMPTS then
			retries += 1
			task.wait(retryBase * 2 ^ (attempt - 1))
		end
	end
	local elapsed = os.clock() - started
	sample(elapsed)
	noteSlow(id, elapsed, attempts, priority)
	releaseSlot()
	if result ~= nil then
		prepareTemplate(result)
		templates[id] = result
		failedUntil[id] = nil
	else
		failedUntil[id] = os.clock() + RETRY_COOLDOWN
		warn(`[MeshLibrary] mesh {id} unavailable after {MAX_ATTEMPTS} attempts: {lastError}`)
	end
	local waiters = waiting[id] or {}
	waiting[id] = nil
	for _, thread in waiters do
		task.spawn(thread)
	end
	return result
end

--[[
	Loads every id in parallel (each through fetchTemplate's priority limiter) and yields until
	all are settled. Returns true when every id has a template.
]]
local function loadAll(ids: { number }, priority: number): boolean
	local missing: { number } = {}
	for _, id in ids do
		if templates[id] == nil then
			table.insert(missing, id)
		end
	end
	if #missing > 0 then
		local remaining = #missing
		local caller = coroutine.running()
		local suspended = false
		for _, id in missing do
			task.spawn(function()
				fetchTemplate(id, priority)
				remaining -= 1
				-- Luau runs one thread at a time, so `suspended` cannot change between the check
				-- below and the caller's yield: the last finisher always resumes the caller.
				if remaining == 0 and suspended then
					task.spawn(caller)
				end
			end)
		end
		if remaining > 0 then
			suspended = true
			coroutine.yield()
		end
	end
	for _, id in ids do
		if templates[id] == nil then
			return false
		end
	end
	return true
end

-- Distinct MeshIds of a model, or nil if any piece is not uploaded yet (id 0).
local function meshIdsOf(asset: MeshAssets.ModelAsset): { number }?
	local ids: { number } = {}
	local seen: { [number]: boolean } = {}
	for _, name in asset.order do
		local id = asset.pieces[name].id
		if id <= 0 then
			return nil
		end
		if not seen[id] then
			seen[id] = true
			table.insert(ids, id)
		end
	end
	return ids
end

-- Colour of one piece for this spawn: per-piece override > tint (tinted pieces) > authored.
local function colorFor(name: string, piece: MeshAssets.Piece, options: SpawnOptions): Color3
	local overrides = options.colors
	if overrides ~= nil and overrides[name] ~= nil then
		return overrides[name]
	end
	if piece.tinted and options.tint ~= nil then
		return options.tint
	end
	return piece.color
end

-- Primitive stand-in for one piece (exact box of the Blender piece, same colour + material).
local function fallbackPart(): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.EnableFluidForces = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

--[[
	True when every piece of `modelKey` has an uploaded MeshId (does not check that it loads).
	@param modelKey string  MeshAssets key
]]
function MeshLibrary.isUploaded(modelKey: string): boolean
	local asset = MeshAssets[modelKey]
	return asset ~= nil and meshIdsOf(asset) ~= nil
end

-- True when MeshAssets knows this key.
function MeshLibrary.has(modelKey: string): boolean
	return MeshAssets[modelKey] ~= nil
end

-- Distinct MeshIds of every uploaded key in `keys`, in key order (unknown / not-uploaded keys
-- are skipped: their spawns use the fallback).
local function uniqueIdsOf(keys: { string }): { number }
	local ids: { number } = {}
	local seen: { [number]: boolean } = {}
	for _, key in keys do
		local asset = MeshAssets[key]
		local list = asset and meshIdsOf(asset)
		if list ~= nil then
			for _, id in list do
				if not seen[id] then
					seen[id] = true
					table.insert(ids, id)
				end
			end
		end
	end
	return ids
end

-- Boot phase: keys requested at Plot priority or more urgent are first-view content (a joining
-- player's plot, the hub build), so their spawns keep Now priority and gate WorldReady.
local function noteFirstView(keys: { string }, priority: number)
	if worldReadyDone or priority > MeshLibrary.Priority.Plot then
		return
	end
	for _, key in keys do
		firstViewKeys[key] = true
	end
end

--[[
	Fetches the templates of every uploaded key in `keys` (bounded concurrency) and yields until
	they are settled. Unknown or not-yet-uploaded keys are skipped (their spawns use the fallback).

	@param keys { string }  MeshAssets keys, e.g. an area's pad build list (PreloadList.plotKeys)
	@param priority number?  MeshLibrary.Priority (default Plot)
	@return number, number  templates ready, templates failed
]]
function MeshLibrary.preload(keys: { string }, priority: number?): (number, number)
	WorldMaterials.ensure()
	local urgency = priority or MeshLibrary.Priority.Plot
	noteFirstView(keys, urgency)
	local ids = uniqueIdsOf(keys)
	loadAll(ids, urgency)
	local ready = 0
	for _, id in ids do
		if templates[id] ~= nil then
			ready += 1
		end
	end
	return ready, #ids - ready
end

--[[
	Queues the templates of every uploaded key in `keys` WITHOUT yielding: requests join the same
	priority-ordered, MAX_CONCURRENT-bounded queue as preload / spawn and run in the background.
	Lets a caller line up far more work than it waits on, so the request slots never sit idle
	between its own sequential preload() calls (owner R16: PlotBuilder.restore prefetches every
	owned area up front, then preloads + builds area by area as before).
	  * cached ids and ids cooling down after a failure are skipped;
	  * ids already requested are not requested again, only promoted when `priority` is more urgent;
	  * within one priority, requests start in call order (keys order), so prefetch the nearest
	    content first;
	  * LEGACY benchmark mode (pre-R16 loader) has no prefetch: returns 0 and queues nothing.

	@param keys { string }  MeshAssets keys (unknown / not-uploaded keys are skipped)
	@param priority number?  MeshLibrary.Priority (default Plot)
	@return number  newly queued template requests
	Example:
		MeshLibrary.prefetch(areaOneKeys, MeshLibrary.Priority.Hub) -- returns at once
		MeshLibrary.preload(areaOneKeys, MeshLibrary.Priority.Plot) -- waits only for these
]]
function MeshLibrary.prefetch(keys: { string }, priority: number?): number
	if LEGACY then
		return 0
	end
	WorldMaterials.ensure()
	local urgency = priority or MeshLibrary.Priority.Plot
	noteFirstView(keys, urgency)
	local now = os.clock()
	local queued = 0
	for _, id in uniqueIdsOf(keys) do
		if templates[id] ~= nil or (failedUntil[id] or 0) > now then
			continue
		end
		if waiting[id] ~= nil then
			-- In flight or queued: only raise its urgency (a slot it already holds is unaffected).
			local waiter = queuedById[id]
			if waiter ~= nil and urgency < waiter.priority then
				waiter.priority = urgency
			end
			continue
		end
		-- task.spawn runs fetchTemplate up to its first yield (slot wait or the asset request), and
		-- it marks `waiting[id]` before that, so the caller never yields and duplicates dedupe.
		task.spawn(fetchTemplate, id, urgency)
		queued += 1
	end
	return queued
end

--[[
	Spawns one model. Pieces are placed at `pivot * CFrame.new(piece.offset)` with the authored
	size, so the model matches its Blender layout exactly; the Model's WorldPivot is `pivot`.

	@param modelKey string       MeshAssets key (errors if unknown)
	@param parent Instance?      parent for the finished model (nil = caller parents it later)
	@param pivot CFrame          world CFrame of the model pivot (see MeshAssets[key].pivot)
	@param opts SpawnOptions?    tint / colors / name / fallback / streamingMode / castShadow
	@return Model                attributes: MeshKey, MeshSource = "Mesh" | "Fallback"
]]
function MeshLibrary.spawn(modelKey: string, parent: Instance?, pivot: CFrame, opts: SpawnOptions?): Model
	local asset = MeshAssets[modelKey]
	if asset == nil then
		error(`[MeshLibrary] unknown model key "{modelKey}"`, 2)
	end
	WorldMaterials.ensure()
	local options: SpawnOptions = opts or {}
	local ids = if options.fallback then nil else meshIdsOf(asset)
	local useMeshes = false
	if ids ~= nil then
		-- Player-first load order (owner R16): a spawn someone is waiting on goes first (Now) and
		-- WorldReady waits for it. Scenery (`deferred`) and, during the boot phase, any key that
		-- is not first-view content (effect templates, event decor, rival turrets) are deferred:
		-- they never hold WorldReady and load behind the hub + own plot (boot phase: Deferred,
		-- still ahead of the warm-up tiers so a caller that blocks on them is not starved;
		-- `deferred`: Background).
		local bootDeferred = not LEGACY and not worldReadyDone and not firstViewKeys[modelKey]
		local deferred = not LEGACY and (options.deferred == true or bootDeferred)
		local priority = options.priority
			or (
				if options.deferred == true and not LEGACY
					then MeshLibrary.Priority.Background
					elseif deferred then MeshLibrary.Priority.Deferred
					else MeshLibrary.Priority.Now
			)
		if deferred then
			deferredSpawns += 1
		else
			pendingSpawns += 1
		end
		useMeshes = loadAll(ids, priority)
		if not deferred then
			pendingSpawns -= 1
		end
	end
	local castShadow = options.castShadow ~= false
	local model = Instance.new("Model")
	model.Name = options.name or modelKey
	model.ModelStreamingMode = options.streamingMode or Enum.ModelStreamingMode.Atomic
	for buildOrder, name in asset.order do
		local piece = asset.pieces[name]
		local part: BasePart
		if useMeshes then
			part = (templates[piece.id] :: MeshPart):Clone()
		else
			part = fallbackPart()
		end
		part.Name = name
		part.Size = piece.size
		-- Mesh pieces undo the 180° yaw Roblox's FBX import bakes into the vertices (R17/R25/R26);
		-- primitive fallback boxes have no vertex data and are placed as authored.
		part.CFrame = MeshPlacement.pieceCFrame(pivot, piece.offset, useMeshes)
		if useMeshes then
			part:SetAttribute(MeshPlacement.YawAttribute, true)
		end
		-- Glow budget (R19): big Neon pieces render as bright SmoothPlastic so bloom can't blow out.
		local materialName, color =
			MeshPlacement.resolveGlow(piece.material, piece.size, colorFor(name, piece, options))
		part.Color = color
		part.Transparency = piece.transparency
		part.CastShadow = castShadow and piece.transparency < 0.5
		WorldMaterials.apply(part, materialName)
		-- Bottom-to-top index for the client LEGO build-in (BuildInController sorts by it).
		part:SetAttribute("BuildOrder", buildOrder)
		if isFxPiece(modelKey, name) then
			-- Rotor/Belt/Glow/... pieces: animated by the client WorldFxController (data-driven).
			CollectionService:AddTag(part, WorldFxConfig.Tag)
		end
		part.Parent = model
	end
	model.WorldPivot = pivot
	model:SetAttribute("MeshKey", modelKey)
	model:SetAttribute("MeshSource", if useMeshes then "Mesh" else "Fallback")
	if parent ~= nil then
		model.Parent = parent
	end
	return model
end

--[[
	Model-space bounding box of a key (relative to its pivot): returns (centre CFrame, size).
	Level builders use it to size invisible collision blocks and pad trigger zones.
	Example: local c, s = MeshLibrary.getBounds("Workbench"); box.CFrame = pivot * c; box.Size = s
]]
function MeshLibrary.getBounds(modelKey: string): (CFrame, Vector3)
	local cached = boundsCache[modelKey]
	if cached ~= nil then
		return cached.cframe, cached.size
	end
	local asset = MeshAssets[modelKey]
	if asset == nil then
		error(`[MeshLibrary] unknown model key "{modelKey}"`, 2)
	end
	local lo = Vector3.one * math.huge
	local hi = -Vector3.one * math.huge
	for _, piece in asset.pieces do
		lo = lo:Min(piece.offset - piece.size / 2)
		hi = hi:Max(piece.offset + piece.size / 2)
	end
	local result = { cframe = CFrame.new((lo + hi) / 2), size = hi - lo }
	boundsCache[modelKey] = result
	return result.cframe, result.size
end

export type LoadStats = {
	templates: number,
	coolingDown: number,
	inFlight: number,
	queued: number,
	maxConcurrent: number,
	legacy: boolean,
	requests: number,
	avgSeconds: number,
	p50Seconds: number,
	p90Seconds: number,
	maxSeconds: number,
	milestones: { [string]: number },
	-- Player-first diagnostics (owner R16 follow-up).
	retries: number,
	deferredSpawns: number,
	firstViewKeys: number,
	worldReady: boolean,
	holds: { [string]: number },
	slowest: { SlowRequest },
}

--[[
	Load counters + latency of CreateMeshPartAsync requests (including retries) and boot
	milestones in seconds since this module loaded (~server boot): tier1, hubFar, tier2, tier3,
	tier4, worldReady; plus retried attempts, boot-deferred spawns, first-view key count, active
	WorldReady holds and the slowest requests (id / seconds / attempts / priority). Used by the
	R16 benchmark (tools/qa/load_benchmark.py) and the dev console.
]]
function MeshLibrary.stats(): LoadStats
	local count, cooling, firstViewCount = 0, 0, 0
	local now = os.clock()
	for _ in firstViewKeys do
		firstViewCount += 1
	end
	for _ in templates do
		count += 1
	end
	for _, untilTime in failedUntil do
		if untilTime > now then
			cooling += 1
		end
	end
	local sorted = table.clone(samples)
	table.sort(sorted)
	local total = 0
	for _, value in sorted do
		total += value
	end
	local n = #sorted
	local function pct(p: number): number
		return if n == 0 then 0 else sorted[math.clamp(math.ceil(n * p), 1, n)]
	end
	return {
		templates = count,
		coolingDown = cooling,
		inFlight = inFlight,
		queued = #slotQueue,
		maxConcurrent = MAX_CONCURRENT,
		legacy = LEGACY,
		requests = n,
		avgSeconds = if n == 0 then 0 else total / n,
		p50Seconds = pct(0.5),
		p90Seconds = pct(0.9),
		maxSeconds = if n == 0 then 0 else sorted[n],
		milestones = table.clone(milestones),
		retries = retries,
		deferredSpawns = deferredSpawns,
		firstViewKeys = firstViewCount,
		worldReady = worldReadyDone,
		holds = table.clone(holds),
		slowest = table.clone(slowest),
	}
end

--------------------------------------------------------------------------------------------------
-- Boot warm-up + WorldReady (owner R16)
--------------------------------------------------------------------------------------------------

local warmupStarted = false

-- HubLayout, required on first use (boot warm-up / isNearHub): the lune queue tests load this
-- module with stub services and no layouts.
local hubLayoutCache: any = nil
local function hubLayout(): any
	if hubLayoutCache == nil then
		hubLayoutCache = require(ReplicatedStorage.Shared.Config.HubLayout)
	end
	return hubLayoutCache
end

-- True while any builder holds WorldReady (MeshLibrary.holdWorldReady).
local function held(): boolean
	return next(holds) ~= nil
end

--[[
	Sets Workspace.WorldReady once the first view is cached, no first-view spawn is still waiting
	on a template and no builder holds it (the hub's near pass is placed). Gives up waiting after
	20 s so clients never hang. Ends the boot phase: later spawns are never boot-deferred.
]]
local function publishWorldReady()
	local deadline = os.clock() + 20
	local quietSince: number? = nil
	while os.clock() < deadline do
		if pendingSpawns == 0 and not held() then
			quietSince = quietSince or os.clock()
			if os.clock() - (quietSince :: number) >= 0.5 then
				break
			end
		else
			quietSince = nil
		end
		task.wait(0.1)
	end
	worldReadyDone = true
	milestones.worldReady = os.clock() - bootClock
	Workspace:SetAttribute("WorldReadySeconds", math.round(milestones.worldReady * 100) / 100)
	Workspace:SetAttribute("WorldReady", true)
end

--[[
	Holds Workspace.WorldReady until the returned release function is called (each hold is
	released once; holds after WorldReady are no-ops). A builder that places first-view content
	in passes holds it for its first pass, so the loading screen never ends on a half-built hub.
	HubBuilder uses reason "hub" (MeshLibrary.HubHold) for its near-first pass: while that hold is
	in use, hub decoration farther than NEAR_HUB_RADIUS from the spawn no longer gates WorldReady
	and loads at Background priority after it.
	@param reason string  shown in stats().holds
	@return () -> ()  release (idempotent)
	Example:
		local release = MeshLibrary.holdWorldReady(MeshLibrary.HubHold)
		buildNearHub()
		release()
]]
function MeshLibrary.holdWorldReady(reason: string): () -> ()
	if worldReadyDone then
		return function() end
	end
	holds[reason] = (holds[reason] or 0) + 1
	if reason == HUB_HOLD then
		hubHoldSeen = true
	end
	local released = false
	return function()
		if released then
			return
		end
		released = true
		local count = (holds[reason] or 1) - 1
		holds[reason] = if count > 0 then count else nil
	end
end

-- HubBuilder's hold reason for its near-first pass (see holdWorldReady).
MeshLibrary.HubHold = HUB_HOLD

--[[
	True when a hub placement at `cf` is first-view content (within NEAR_HUB_RADIUS of the hub
	spawn). HubBuilder's near-first pass spawns these; the rest load after WorldReady.
	Example: if MeshLibrary.isNearHub(entry.cf) then table.insert(nearPass, entry) end
]]
function MeshLibrary.isNearHub(cf: CFrame): boolean
	local spawnCf: any = hubLayout().spawn
	local origin = if typeof(spawnCf) == "CFrame" then spawnCf.Position else Vector3.zero
	return (cf.Position - origin).Magnitude <= NEAR_HUB_RADIUS
end

--[[
	Splits boot tier 1 into the first view and the far hub decoration: a key is "far" when it is a
	HubLayout model whose every placement lies beyond NEAR_HUB_RADIUS of the spawn — or lobby decor
	(HubLayout.isDeferred) — and no other first-view source (plot frame, locked slot, BuyPad,
	Area 1) uses it.
	@param tier1 { string }  PreloadList.tiers()[1]
	@return (first view keys, far hub keys)
]]
local function splitTierOne(tier1: { string }): ({ string }, { string })
	local near: { [string]: boolean } = {}
	local hubOnly: { [string]: boolean } = {}
	local isDeferred = hubLayout().isDeferred :: ((string) -> boolean)?
	for _, entry in hubLayout().models or {} do
		if type(entry) == "table" and type(entry.key) == "string" and typeof(entry.cf) == "CFrame" then
			hubOnly[entry.key] = true
			-- Lobby decor HubBuilder spawns after WorldReady (HubLayout.isDeferred) is never near.
			local decor = false
			if isDeferred ~= nil then
				local ok, result = pcall(isDeferred, entry.key)
				decor = ok and result == true
			end
			if not decor and MeshLibrary.isNearHub(entry.cf) then
				near[entry.key] = true
			end
		end
	end
	-- Keys a player's own plot needs are first view even when the hub also uses them far out.
	local plotNeeds: { [string]: boolean } = { BuyPad = true }
	for _, key in PreloadList.areaKeys(1) do
		plotNeeds[key] = true
	end
	for _, group in { hubLayout().plotFrame, hubLayout().lockedSlot } do
		if type(group) == "table" and type(group.models) == "table" then
			for _, entry in group.models do
				if type(entry) == "table" and type(entry.key) == "string" then
					plotNeeds[entry.key] = true
				end
			end
		end
	end
	local first, far = {}, {}
	for _, key in tier1 do
		if hubOnly[key] and not near[key] and not plotNeeds[key] then
			table.insert(far, key)
		else
			table.insert(first, key)
		end
	end
	return first, far
end

--[[
	Starts the tiered boot warm-up (idempotent; called automatically when the module loads in a
	running server). Player first (owner R16 follow-up):
		1   first view: hub models near the spawn, plot frame, BuyPad, Area 1 — Hub priority; gates
		    WorldReady (with any first-view spawn still loading and any builder hold)
		1b  far hub decoration — Background; gates WorldReady only while HubBuilder builds in one
		    pass (no "hub" hold seen: it needs every hub template before it spawns anything)
		2-4 areas 2-4, 5-10, everything else — Background / Idle, never delay a player's requests
]]
function MeshLibrary.warmup()
	if warmupStarted or LEGACY then
		return
	end
	warmupStarted = true
	local tiers = PreloadList.tiers()
	local firstView, farHub = splitTierOne(tiers[1] or {})
	for _, key in firstView do
		firstViewKeys[key] = true
	end
	task.spawn(function()
		MeshLibrary.preload(firstView, MeshLibrary.Priority.Hub)
		milestones.tier1 = os.clock() - bootClock
		if #farHub > 0 and not hubHoldSeen then
			-- Single-pass HubBuilder: the hub only appears once every template is cached, so the far
			-- decoration must gate WorldReady too (promoted to Hub priority).
			MeshLibrary.preload(farHub, MeshLibrary.Priority.Hub)
		end
		publishWorldReady()
	end)
	task.spawn(function()
		MeshLibrary.preload(farHub, MeshLibrary.Priority.Background)
		milestones.hubFar = os.clock() - bootClock
	end)
	for index = 2, #tiers do
		task.spawn(function()
			local priority = if index == #tiers then MeshLibrary.Priority.Idle else MeshLibrary.Priority.Background
			MeshLibrary.preload(tiers[index], priority)
			milestones[`tier{index}`] = os.clock() - bootClock
		end)
	end
end

-- Running server only (never in Studio edit mode, where tools require this module for previews).
if RunService:IsServer() and RunService:IsRunning() then
	task.defer(MeshLibrary.warmup)
end

return MeshLibrary
