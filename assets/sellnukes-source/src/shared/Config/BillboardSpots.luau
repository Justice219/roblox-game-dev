-- Freezes every nested table (rows, spots, worlds): callers copy what they need, never mutate.
local function deepFreeze(t: any): any
	for _, value in t do
		if type(value) == "table" then
			deepFreeze(value)
		end
	end
	return table.freeze(t)
end

return deepFreeze(spots) :: Spots
