--!strict
--[[
	BillboardSpots — GENERATED by tools/billboards/generate-spots.luau. Do not edit by hand: re-run
	`lune run tools/billboards/generate-spots.luau` after changing an area layout, a mesh, a manager
	rig or a Placement / Billboard tunable (tests/billboard-clearance.luau fails while it is stale).

	The producer billboard spot of every area in SLOT-LOCAL space (one answer for all 8 plots),
	for the desktop and the phone / tablet / console board size, exactly as
	Tycoon/BillboardPlacement.choose(areaInput(...)) returns it. ProducerBillboards maps it through
	the plot's slot frame (world = WorldLayout.slotOrigin(plot, area) * position).

	Worlds (owner R57): Nuke Town's areas 1-10 are the top-level rows `BillboardSpots[area]`;
	every other world of WorldsConfig.Order is `BillboardSpots.worlds[worldId][area]` (same Spot
	shape, same slot-local space: world = WorldLayout.slotOrigin(plot, area, worldId) * position).
	Read-only all the way down (deep-frozen).
	Example: (BillboardSpots.worlds.dino or {})[6].device.position --> D6's board, phone size
]]

export type Spot = {
	position: Vector3, -- slot-local board centre
	side: number, -- +1 / -1: the viewer's right / left of the producer (income pops go there)
	right: Vector3, -- the viewer's right in slot space
	family: string, -- "above" | "side" | "fallback"
	clear: boolean,
	readable: boolean,
	slabClear: boolean,
	blockedRays: number,
	elevation: number,
	height: number,
}

-- One area: its spot per board size.
export type AreaSpots = { desktop: Spot, device: Spot }

-- [area] = Nuke Town; worlds[worldId][area] = every other world (WorldsConfig.Order).
export type Spots = { [number]: AreaSpots, worlds: { [string]: { [number]: AreaSpots } } }

