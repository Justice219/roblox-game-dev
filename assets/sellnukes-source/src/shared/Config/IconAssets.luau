--[[
	The canonical key for `key` (itself, or the alias target), or nil when unknown.
	Example: IconAssets.resolve("DoubleCash") --> "x2Cash"
]]
function IconAssets.resolve(key: string): string?
	if IconAssets.Icons[key] ~= nil then
		return key
	end
	return IconAssets.Aliases[key] or IconAssets.Lower[string.lower(key)]
end

--[[
	The icon entry for a key or alias; a blank entry (image "") for unknown keys.
	Example: IconAssets.get("Gems").image --> "rbxassetid://..." or ""
]]
function IconAssets.get(key: string): IconEntry
	local resolved = IconAssets.resolve(key)
	if resolved == nil then
		return BLANK
	end
	return IconAssets.Icons[resolved] or BLANK
end

--[[
	Legacy helper: the content id for a key or alias, or nil while it is not uploaded / unknown.
	Example: IconAssets.image("Gem") --> "rbxassetid://..." or nil
]]
function IconAssets.image(key: string): string?
	local image = IconAssets.get(key).image
	return if image ~= "" then image else nil
end

return table.freeze(IconAssets)
