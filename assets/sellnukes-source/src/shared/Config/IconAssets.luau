-- Entries are frozen (immutable), hence read-only properties.
export type IconEntry = {
	read image: string,
	read size: Vector2,
	read category: string,
	read source: string,
}

-- Every icon is rendered at 512 x 512.
local SIZE = Vector2.new(512, 512)

--[[
	Builds one frozen icon entry.
	@param id       uploaded Image asset id (0 = not uploaded / rejected -> image "")
	@param category "hud" | "currency" | "offer" | "reward" | "game" | "area" | "ui" | "event"
	@param source   "pack" (Fluent Emoji 3D) | "blender" (original render) | "composite"
	Example: entry(123, "hud", "pack").image --> "rbxassetid://123"
]]
local function entry(id: number, category: string, source: string): IconEntry
	return table.freeze({
		image = if id > 0 then `rbxassetid://{id}` else "",
		size = SIZE,
		category = category,
		source = source,
	})
end

-- Returned for unknown keys so callers never index nil.
local BLANK: IconEntry = entry(0, "", "")

