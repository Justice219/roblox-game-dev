local SIZE = 256
local CELL = 128
-- Unique cell (0 = light, 1 = dark) at each 2x2 tile position, row-major.
local LAYOUT = { 0, 1, 1, 0 }

-- Decode trusted build-time records into fresh RGBA bytes. Call once per shared bitmap,
-- never per panel or frame. Each record is a uint16 count followed by one RGBA pixel; the
-- records expand to the light cell then the dark cell, which are then copied row by row
-- (one 512-byte buffer.copy per cell row) into their checker positions.
local function createBuffer(): buffer
	local cellBytes = CELL * CELL * 4
	local cells = buffer.create(cellBytes * 2)
	local destination = 0
	for offset = 0, buffer.len(RUNS) - 1, 6 do
		local count = buffer.readu16(RUNS, offset)
		local rgba = buffer.readu32(RUNS, offset + 2)
		for _ = 1, count do
			buffer.writeu32(cells, destination, rgba)
			destination += 4
		end
	end
	assert(destination == cellBytes * 2, "Stud cell pixel count mismatch")
	local pixels = buffer.create(SIZE * SIZE * 4)
	local rowBytes = CELL * 4
	for y = 0, SIZE - 1 do
		local cellY = y // CELL
		local inner = (y % CELL) * rowBytes
		for cellX = 0, SIZE // CELL - 1 do
			local kind = LAYOUT[cellY * 2 + cellX + 1]
			buffer.copy(pixels, (y * SIZE + cellX * CELL) * 4, cells, kind * cellBytes + inner, rowBytes)
		end
	end
	return pixels
end

